<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stark Industries // Shot-Protokoll</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #040914;
            color: #e2e8f0;
            touch-action: manipulation;
        }
        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }
        /* Hologram / Arc Glow Effekt-Klassen */
        .arc-glow {
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.5), inset 0 0 15px rgba(6, 182, 212, 0.3);
        }
        .arc-glow-red {
            box-shadow: 0 0 35px rgba(225, 29, 72, 0.6), inset 0 0 20px rgba(225, 29, 72, 0.4);
        }
        .arc-glow-green {
            box-shadow: 0 0 35px rgba(16, 185, 129, 0.6), inset 0 0 20px rgba(16, 185, 129, 0.4);
        }
        .arc-text-glow {
            text-shadow: 0 0 10px rgba(6, 182, 212, 0.8), 0 0 20px rgba(6, 182, 212, 0.4);
        }
        .cyber-border {
            border: 1px solid rgba(6, 182, 212, 0.3);
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.92) 0%, rgba(6, 182, 212, 0.05) 100%);
            backdrop-filter: blur(12px);
        }
        /* Grid Hintergrund */
        .bg-grid {
            background-size: 30px 30px;
            background-image: 
                linear-gradient(to right, rgba(6, 182, 212, 0.05) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(6, 182, 212, 0.05) 1px, transparent 1px);
        }
        /* Pulsieren für Arc Reactor */
        @keyframes arcPulse {
            0%, 100% { opacity: 0.95; transform: scale(1); }
            50% { opacity: 0.6; transform: scale(0.98); }
        }
        .arc-pulse {
            animation: arcPulse 2.5s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-grid min-h-screen flex flex-col items-center justify-between p-4 overflow-x-hidden select-none">

    <!-- Header / HUD Leiste -->
    <header class="w-full max-w-md flex items-center justify-between py-3 px-4 cyber-border rounded-xl mb-3 border-cyan-500/30">
        <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-full border border-cyan-400 flex items-center justify-center bg-cyan-950/60 shadow-[0_0_10px_rgba(6,182,212,0.5)]">
                <i class="fa-solid fa-atom text-cyan-400 text-sm"></i>
            </div>
            <div>
                <h1 class="font-orbitron text-xs tracking-widest text-cyan-400 uppercase font-bold">Stark Industries</h1>
                <p class="text-[10px] text-slate-400 tracking-wider">PROTOKOLL: SHOT_SELEKTOR_v2.0</p>
            </div>
        </div>
        <div class="flex items-center space-x-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider">SYSTEM AKTIV</span>
        </div>
    </header>

    <!-- Hauptbereich -->
    <main class="w-full max-w-md flex-1 flex flex-col items-center justify-center relative my-auto">
        
        <!-- Titel & J.A.R.V.I.S. Status -->
        <div class="text-center mb-4">
            <div class="inline-block px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/40 text-cyan-300 text-xs font-orbitron tracking-wider mb-2">
                <i class="fa-solid fa-microchip text-cyan-400 mr-1.5"></i> J.A.R.V.I.S. ALGORITHMUS
            </div>
            <h2 class="text-2xl font-black font-orbitron text-white tracking-wide uppercase arc-text-glow">
                SHOT ODER KEIN SHOT?
            </h2>
            <p class="text-xs text-slate-400 mt-1 uppercase tracking-widest">
                Scannen verifiziert. Starte die Analyse...
            </p>
        </div>

        <!-- Glücksrad Frame -->
        <div class="relative w-full max-w-[320px] aspect-square flex items-center justify-center my-2">
            
            <!-- Äußere leuchtende HUD-Ringe -->
            <div class="absolute inset-0 rounded-full border-2 border-dashed border-cyan-500/40 arc-pulse pointer-events-none"></div>
            <div class="absolute -inset-3 rounded-full border border-cyan-400/20 pointer-events-none"></div>

            <!-- Zeiger oben (Marker) -->
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center">
                <div class="w-0 h-0 border-l-[14px] border-l-transparent border-r-[14px] border-r-transparent border-t-[22px] border-t-amber-400 filter drop-shadow-[0_0_10px_rgba(245,158,11,0.9)]"></div>
            </div>

            <!-- Wheel Canvas -->
            <canvas id="rouletteWheel" width="320" height="320" class="rounded-full shadow-[0_0_35px_rgba(6,182,212,0.3)] border-2 border-cyan-500/50 cursor-pointer"></canvas>

            <!-- Zentrale Arc Reactor Button-Einheit -->
            <button id="spinBtn" onclick="spinWheel()" class="absolute w-20 h-20 rounded-full bg-slate-950 border-2 border-cyan-400 flex flex-col items-center justify-center z-20 transition-all duration-300 hover:scale-105 active:scale-95 arc-glow">
                <div class="w-12 h-12 rounded-full border border-cyan-300/80 flex items-center justify-center bg-cyan-900/40">
                    <i class="fa-solid fa-bolt text-cyan-300 text-xl animate-pulse"></i>
                </div>
                <span class="text-[9px] font-orbitron font-bold text-cyan-200 uppercase mt-0.5 tracking-tighter">DREHEN</span>
            </button>
        </div>

        <!-- System Status Box unten -->
        <div id="statusCard" class="w-full mt-4 p-4 cyber-border rounded-xl text-center min-h-[90px] flex flex-col items-center justify-center transition-all duration-300">
            <div id="statusTitle" class="text-xs font-orbitron text-cyan-400 tracking-widest uppercase mb-1">
                BEREIT ZUR ANALYSE
            </div>
            <p id="statusDesc" class="text-sm text-slate-300 font-medium">
                Tippe auf den Arc Reactor in der Mitte, um die Radeinheit zu starten!
            </p>
        </div>
    </main>

    <!-- Modal Fenster für die finale Entscheidung -->
    <div id="outcomeModal" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300">
        <div id="modalBox" class="cyber-border bg-slate-900 border-2 border-cyan-400 rounded-2xl p-6 max-w-sm w-full text-center relative overflow-hidden transition-all duration-300 transform scale-95">
            
            <!-- HUD Ecken-Design -->
            <div class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-cyan-400"></div>
            <div class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-cyan-400"></div>
            <div class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-cyan-400"></div>
            <div class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-cyan-400"></div>

            <div id="modalIconContainer" class="w-20 h-20 mx-auto mb-4 rounded-full bg-cyan-950/80 border border-cyan-400 flex items-center justify-center arc-glow">
                <i id="modalIcon" class="fa-solid fa-glass-whiskey text-3xl text-cyan-300"></i>
            </div>

            <div id="modalTag" class="text-xs font-orbitron text-amber-400 font-bold uppercase tracking-widest mb-1">
                J.A.R.V.I.S. ENTSCHEIDUNG
            </div>
            
            <h3 id="modalTitle" class="text-3xl font-black font-orbitron text-white mb-2 tracking-wider">
                SHOT!
            </h3>

            <p id="modalDescription" class="text-slate-200 text-base mb-6 font-medium leading-relaxed">
                Keine Ausreden! Das Stark-Protokoll verlangt einen Shot von dir.
            </p>

            <button onclick="closeModal()" class="w-full py-3.5 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-orbitron font-bold text-sm rounded-xl tracking-wider uppercase shadow-[0_0_20px_rgba(6,182,212,0.5)] active:scale-95 transition-all">
                AKZEPTIEREN & BESTÄTIGEN
            </button>
        </div>
    </div>

    <!-- Footer -->
    <footer class="w-full max-w-md text-center py-2 mt-2">
        <p class="text-[10px] text-slate-500 font-mono tracking-widest">STARK ENTERTAINMENT SYSTEMS &copy; 2026</p>
    </footer>

    <!-- Audio Synthesizer & Glücksrad Logik -->
    <script>
        // Web Audio API für Sound-Effekte ohne externe Dateien
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        let audioCtx;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new AudioCtx();
            }
        }

        // Ticking-Sound beim Drehen
        function playTickSound() {
            try {
                initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(350 + Math.random() * 150, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.03);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.03);
            } catch (e) {}
        }

        // Fanfare / Sound beim Stoppen
        function playOutcomeSound(isShot) {
            try {
                initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();

                if (isShot) {
                    // Warnton / Stark Repulsor Sound
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(180, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(520, audioCtx.currentTime + 0.35);
                    gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
                } else {
                    // Positiver J.A.R.V.I.S. Bestätigungston
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(440, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.3);
                    gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
                }

                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.5);
            } catch (e) {}
        }

        // Segment-Konfiguration (6 Segmente, abwechselnd SHOT / KEIN SHOT)
        const segments = [
            { type: "SHOT", label: "SHOT", color: "#e11d48", bg: "#1e1b2e", icon: "fa-fire", desc: "Keine Ausreden! Das Stark-Protokoll verlangt sofort einen Shot von dir." },
            { type: "NO_SHOT", label: "KEIN SHOT", color: "#10b981", bg: "#0f232a", icon: "fa-shield-halved", desc: "Glück gehabt! Schutzschild aktiv – du musst diesen Durchgang NICHT trinken." },
            { type: "SHOT", label: "SHOT", color: "#e11d48", bg: "#1e1b2e", icon: "fa-glass-whiskey", desc: "Energie-Repulsor aufgeladen! Trinke jetzt einen Shot." },
            { type: "NO_SHOT", label: "KEIN SHOT", color: "#10b981", bg: "#0f232a", icon: "fa-check-circle", desc: "Analyse negativ. Kein Shot erforderlich. Du darfst aussetzen!" },
            { type: "SHOT", label: "SHOT", color: "#e11d48", bg: "#1e1b2e", icon: "fa-bolt", desc: "Systemüberlastung! Ab an die Bar und einen Shot trinken." },
            { type: "NO_SHOT", label: "KEIN SHOT", color: "#10b981", bg: "#0f232a", icon: "fa-thumbs-up", desc: "J.A.R.V.I.S. gewährt dir Immunität. Du musst keinen Shot nehmen." }
        ];

        const numSegments = segments.length;
        const segmentAngle = (2 * Math.PI) / numSegments;
        const canvas = document.getElementById("rouletteWheel");
        const ctx = canvas.getContext("2d");

        let currentAngle = 0;
        let isSpinning = false;
        let lastSegmentIndex = -1;

        // Glücksrad zeichnen
        function drawWheel() {
            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;
            const outerRadius = canvas.width / 2 - 8;
            const innerRadius = 45; // Platz für Arc Reactor Core Button

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            for (let i = 0; i < numSegments; i++) {
                const startAngle = currentAngle + i * segmentAngle;
                const endAngle = startAngle + segmentAngle;
                const seg = segments[i];

                // Hintergrund Slice
                ctx.beginPath();
                ctx.moveTo(centerX, centerY);
                ctx.arc(centerX, centerY, outerRadius, startAngle, endAngle);
                ctx.fillStyle = seg.bg;
                ctx.fill();

                // Innere Neon Trennlinie
                ctx.lineWidth = 2;
                ctx.strokeStyle = "rgba(6, 182, 212, 0.4)";
                ctx.stroke();

                // Äußerer Farbakzent (Rot für SHOT, Grün für KEIN SHOT)
                ctx.beginPath();
                ctx.arc(centerX, centerY, outerRadius - 2, startAngle, endAngle);
                ctx.lineWidth = 5;
                ctx.strokeStyle = seg.color;
                ctx.stroke();

                // Textbeschriftung
                ctx.save();
                ctx.translate(centerX, centerY);
                ctx.rotate(startAngle + segmentAngle / 2);
                ctx.textAlign = "right";
                ctx.fillStyle = seg.type === "SHOT" ? "#fca5a5" : "#a7f3d0";
                ctx.font = "bold 15px 'Orbitron', sans-serif";
                
                ctx.fillText(seg.label, outerRadius - 18, 5);
                ctx.restore();
            }

            // Äußerer Metallic Cyber-Ring
            ctx.beginPath();
            ctx.arc(centerX, centerY, outerRadius, 0, 2 * Math.PI);
            ctx.lineWidth = 5;
            ctx.strokeStyle = "rgba(6, 182, 212, 0.8)";
            ctx.stroke();

            // Innerer Cutout-Ring
            ctx.beginPath();
            ctx.arc(centerX, centerY, innerRadius + 2, 0, 2 * Math.PI);
            ctx.lineWidth = 3;
            ctx.strokeStyle = "#06b6d4";
            ctx.stroke();
        }

        // Bestimmt das Segment unter dem Zeiger oben (Position = 3*Math.PI/2)
        function getSelectedSegment() {
            const normalizedAngle = (2 * Math.PI - (currentAngle % (2 * Math.PI))) % (2 * Math.PI);
            const adjustedAngle = (normalizedAngle + (3 * Math.PI / 2)) % (2 * Math.PI);
            return Math.floor(adjustedAngle / segmentAngle) % numSegments;
        }

        // Dreh-Animation ausführen
        function spinWheel() {
            if (isSpinning) return;
            initAudio();

            isSpinning = true;
            document.getElementById("spinBtn").classList.add("scale-90");
            document.getElementById("statusTitle").innerText = "ANALYSE LÄUFT...";
            document.getElementById("statusDesc").innerText = "Berechne Molekular-Protokoll...";

            // Zufällige Umdrehungen (5-8 volle Runden + Zufallswinkel)
            const totalRotation = (Math.floor(Math.random() * 4) + 6) * 2 * Math.PI + (Math.random() * 2 * Math.PI);
            const duration = 4000; // 4 Sekunden Dauer
            const startTime = performance.now();
            const initialAngle = currentAngle;

            function animate(now) {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                
                // Sanftes Abbremsen (Cubic Ease-Out)
                const easeOut = 1 - Math.pow(1 - progress, 3);
                currentAngle = initialAngle + totalRotation * easeOut;

                // Ticking-Sound auslösen bei Segmentwechsel
                const currentSegIndex = getSelectedSegment();
                if (currentSegIndex !== lastSegmentIndex) {
                    playTickSound();
                    lastSegmentIndex = currentSegIndex;
                }

                drawWheel();

                if (progress < 1) {
                    requestAnimationFrame(animate);
                } else {
                    isSpinning = false;
                    document.getElementById("spinBtn").classList.remove("scale-90");
                    const winnerIndex = getSelectedSegment();
                    showResult(winnerIndex);
                }
            }

            requestAnimationFrame(animate);
        }

        // Ergebnis im HUD & Modal anzeigen
        function showResult(index) {
            const item = segments[index];
            const isShot = item.type === "SHOT";

            playOutcomeSound(isShot);

            // Statuskarte unten aktualisieren
            document.getElementById("statusTitle").innerText = `ERGEBNIS: ${item.label}`;
            document.getElementById("statusTitle").style.color = item.color;
            document.getElementById("statusDesc").innerText = item.desc;

            // Modal Inhalte vorbereiten
            const modalBox = document.getElementById("modalBox");
            const modalIconContainer = document.getElementById("modalIconContainer");
            const modalIcon = document.getElementById("modalIcon");

            document.getElementById("modalTitle").innerText = item.label;
            document.getElementById("modalTitle").style.color = item.color;
            document.getElementById("modalDescription").innerText = item.desc;

            // Anpassung von Styles je nach Ergebnis
            if (isShot) {
                modalBox.className = "cyber-border bg-slate-900 border-2 border-rose-500 rounded-2xl p-6 max-w-sm w-full text-center relative overflow-hidden transition-all duration-300 transform scale-100 shadow-[0_0_50px_rgba(225,29,72,0.4)]";
                modalIconContainer.className = "w-20 h-20 mx-auto mb-4 rounded-full bg-rose-950/80 border border-rose-500 flex items-center justify-center arc-glow-red";
                modalIcon.className = `fa-solid ${item.icon} text-3xl text-rose-400`;
                document.getElementById("modalTag").className = "text-xs font-orbitron text-rose-400 font-bold uppercase tracking-widest mb-1";
                document.getElementById("modalTag").innerText = "WARNUNG // STARK PROTOKOLL";
            } else {
                modalBox.className = "cyber-border bg-slate-900 border-2 border-emerald-500 rounded-2xl p-6 max-w-sm w-full text-center relative overflow-hidden transition-all duration-300 transform scale-100 shadow-[0_0_50px_rgba(16,185,129,0.4)]";
                modalIconContainer.className = "w-20 h-20 mx-auto mb-4 rounded-full bg-emerald-950/80 border border-emerald-500 flex items-center justify-center arc-glow-green";
                modalIcon.className = `fa-solid ${item.icon} text-3xl text-emerald-400`;
                document.getElementById("modalTag").className = "text-xs font-orbitron text-emerald-400 font-bold uppercase tracking-widest mb-1";
                document.getElementById("modalTag").innerText = "IMMUNITÄT // FREIGABE";
            }

            // Modal einblenden
            const modal = document.getElementById("outcomeModal");
            modal.classList.remove("hidden");
            setTimeout(() => {
                modal.classList.remove("opacity-0");
                modalBox.classList.remove("scale-95");
                modalBox.classList.add("scale-100");
            }, 50);
        }

        function closeModal() {
            const modal = document.getElementById("outcomeModal");
            const modalBox = document.getElementById("modalBox");
            modalBox.classList.remove("scale-100");
            modalBox.classList.add("scale-95");
            modal.classList.add("opacity-0");
            setTimeout(() => {
                modal.classList.add("hidden");
            }, 250);
        }

        // Setup beim Laden der Seite
        window.onload = function() {
            drawWheel();
        };

        // Screen Resize Handling
        window.addEventListener('resize', () => {
            drawWheel();
        });
    </script>
</body>
</html>
